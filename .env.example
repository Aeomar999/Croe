# Croe — Environment Variables
# Copy to .env and fill in values. Never commit .env itself (see .gitignore).

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://croe:dev@localhost:5432/croe

# ── Cache / Queues ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth & Security ───────────────────────────────────────
# HMAC secret for MoMo webhook signature verification (SEC-01)
MOMO_WEBHOOK_SECRET=          # REQUIRED — never use a hardcoded fallback
JWT_SECRET=                   # REQUIRED — high-entropy signing key for access tokens
OTP_PEPPER=                   # REQUIRED — pepper for hashing OTP codes

# ── Custody Phase ─────────────────────────────────────────
# P0 = sandbox, P1 = pilot, P2 = partner-held, P3 = own licence
CUSTODY_PHASE=P0

# ── Aggregator Credentials ────────────────────────────────
# MoMo / payment aggregator API keys (per-provider)
AGGREGATOR_API_KEY=
AGGREGATOR_BASE_URL=

# ── AI / LLM ─────────────────────────────────────────────
LLM_URL=http://localhost:11434   # Ollama (dev) / vLLM (prod)
LLM_MODEL=                       # pin exact model id at implementation time

# ── Object Storage (evidence media) ───────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── App Config ────────────────────────────────────────────
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000
