# Croe — Environment Variables (backend API)
# Copy to .env and fill in values. Never commit .env itself (see .gitignore).
# Every variable read by backend/src/config/env.ts is listed here. The API
# validates them at boot and exits with the full list of problems (task.md T3.7).

# ── App ───────────────────────────────────────────────────
# NODE_ENV=production additionally requires S3 storage and 32+ char secrets.
NODE_ENV=development
PORT=8080
# Exact number of reverse proxies in front of the API, so req.ip is the real
# client (rate limits, fraud heuristics, forensics). 0 locally, 1 behind Render,
# 2 behind Cloudflare + Render. Required when NODE_ENV=production. Never "true".
TRUST_PROXY_HOPS=0
# Comma-separated exact origins (no wildcards). Must include the admin console.
CORS_ORIGIN=http://localhost:3001

# ── Database ──────────────────────────────────────────────
# Local (Docker):   postgresql://croe:dev@127.0.0.1:5432/croe
DATABASE_URL=postgresql://croe:dev@127.0.0.1:5432/croe

# ── Cache / Queues ────────────────────────────────────────
# Local (Docker):   redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth & Security (REQUIRED, SEC-01) ────────────────────
# Production: at least 32 random bytes each, e.g. `openssl rand -base64 32`,
# and different values per environment (task.md T7.8).
JWT_SECRET=                   # signing key for access tokens
OTP_PEPPER=                   # pepper for hashing OTP codes
# HMAC-SHA256 secret for sandbox/MoMo webhook signatures
MOMO_WEBHOOK_SECRET=
# Paystack signs webhooks with the account SECRET KEY (HMAC-SHA512), so this
# must equal the Paystack secret key and be rotated with it. Required when
# CUSTODY_PHASE != P0; Paystack webhooks are rejected while it is empty.
PAYSTACK_WEBHOOK_SECRET=

# ── Custody Phase ─────────────────────────────────────────
# Exactly one of P0 (sandbox) | P1 (pilot) | P2 (partner-held) | P3 (own licence).
CUSTODY_PHASE=P0

# ── Payment Aggregator (required when CUSTODY_PHASE != P0) ─
AGGREGATOR_API_KEY=           # Paystack secret key (test key on staging)
AGGREGATOR_BASE_URL=          # https://api.paystack.co

# ── SMS (required when CUSTODY_PHASE != P0) ───────────────
ARKESEL_SMS_API_KEY=

# ── Object Storage (evidence media; required when NODE_ENV=production) ──
# Cloudflare R2: S3_REGION=auto and S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── AI / LLM (optional) ───────────────────────────────────
# Leave LLM_MODEL empty to escalate every dispute to UNDER_HUMAN_REVIEW.
LLM_URL=http://localhost:11434   # Ollama (dev) / vLLM (prod)
LLM_MODEL=                       # pin exact model id at implementation time

# ── Alerting (optional in development) ────────────────────
# Slack/Discord-compatible webhook for on-call alerts.
ALERT_WEBHOOK_URL=

# ── Fees (basis points: 250 = 2.5%, max 1000) ─────────────
# Defaults: COMMISSION_BPS=250, BUYER_PROTECTION_FEE_BPS=150.
# Per-market overrides: COMMISSION_BPS_GHS, BUYER_PROTECTION_FEE_BPS_GHS (also _NGN, _KES).
COMMISSION_BPS=
BUYER_PROTECTION_FEE_BPS=

# ── Rate limits (optional; max requests per window) ───────
# Windows: auth 60s, OTP 300s, payment 60s, evidence 60s, dispute 300s, admin 60s.
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_OTP_MAX=3
RATE_LIMIT_PAYMENT_MAX=10
RATE_LIMIT_EVIDENCE_MAX=10
RATE_LIMIT_DISPUTE_MAX=5
RATE_LIMIT_ADMIN_MAX=20

# ── Data retention (days; confirm with legal, task.md T8.6) ──
RETENTION_NOTIFICATION_DAYS=30   # notifications not tied to an open dispute
RETENTION_SESSION_DAYS=7         # how long expired sessions are kept before purge

# ── Dev seed (pnpm db:seed — refuses to run when NODE_ENV=production) ──
# Optional. The admin account is seeded only when both are set. Min 12 chars.
# Never reuse a real password here. Production staff accounts: task.md T7.4.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
