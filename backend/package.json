{
  "name": "croe-backend",
  "version": "0.1.0",
  "description": "Croe — mobile-first trust and escrow service backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -- node-pg-migrate up --tsconfig ./tsconfig.json --migrations-dir ./migrations --migrations-table pgmigrations",
    "db:migrate:down": "dotenv -- node-pg-migrate down --tsconfig ./tsconfig.json --migrations-dir ./migrations --migrations-table pgmigrations",
    "db:migrate:create": "dotenv -- node-pg-migrate create --tsconfig ./tsconfig.json --migrations-dir ./migrations",
    "db:seed": "dotenv -- tsx src/db/seed.ts",
    "test": "dotenv -- vitest run",
    "test:watch": "dotenv -- vitest"
  },
  "keywords": [
    "escrow",
    "fintech",
    "momo",
    "ghana"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.10.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
