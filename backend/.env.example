# Croe — Environment Variables
# Copy to .env and fill in values. Never commit .env itself (see .gitignore).

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://croe:dev@172.25.95.79:5432/croe

# ── Cache / Queues ────────────────────────────────────────
REDIS_URL=redis://172.25.95.79:6379

# ── Auth & Security ───────────────────────────────────────
# HMAC secret for MoMo webhook signature verification (SEC-01)
MOMO_WEBHOOK_SECRET=dev-webhook-secret-not-for-production
JWT_SECRET=dev-jwt-secret-not-for-production
OTP_PEPPER=dev-otp-pepper-not-for-production

# ── Custody Phase ─────────────────────────────────────────
# P0 = sandbox, P1 = pilot, P2 = partner-held, P3 = own licence
CUSTODY_PHASE=P0

# ── Aggregator Credentials ────────────────────────────────
# MoMo / payment aggregator API keys (per-provider)
AGGREGATOR_API_KEY=
AGGREGATOR_BASE_URL=

# ── AI / LLM ─────────────────────────────────────────────
LLM_URL=http://localhost:11434   # Ollama (dev) / vLLM (prod)
LLM_MODEL=                       # pin exact model id at implementation time

# ── Object Storage (evidence media) ───────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── App Config ────────────────────────────────────────────
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:3000

# ── Dev seed (pnpm db:seed — refuses to run when NODE_ENV=production) ──
# Optional. The admin account is seeded only when both are set. Min 12 chars.
# Never reuse a real password here. Production staff accounts: task.md T7.4.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
