# Croe - Production Environment Variables (P1 Pilot)
# Copy these keys into your Render Environment Variables dashboard.

# Node Environment
NODE_ENV="production"
PORT="8080"

# Custody Phase (P1 = Pilot / Aggregator settlement)
CUSTODY_PHASE="P1"

# Database & Redis (Render sets these automatically via fromDatabase/fromService in render.yaml)
# DATABASE_URL="..."
# REDIS_URL="..."

# Security Secrets (Must be strong random strings)
JWT_SECRET=""
OTP_PEPPER=""
MOMO_WEBHOOK_SECRET=""
# Must equal the Paystack secret key (Paystack signs webhooks with it)
PAYSTACK_WEBHOOK_SECRET=""

# Payment Aggregator (e.g. Hubtel, Paystack)
AGGREGATOR_API_KEY=""
AGGREGATOR_BASE_URL=""

# SMS Provider (Arkesel)
ARKESEL_SMS_API_KEY=""

# Object Storage (Cloudflare R2)
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="croe-evidence-prod"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"

# App Security
# Must match your production domain exactly, no trailing slash.
CORS_ORIGIN="https://api.croe.com"

# Local LLM overrides (Leave blank for P1 to force UNDER_HUMAN_REVIEW fallback)
# LLM_URL=""
# LLM_MODEL=""
