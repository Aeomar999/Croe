# Croe — Production/Staging Environment Variables
# render.yaml declares every variable below; secrets marked `sync: false` there
# are entered in the Render dashboard. Never commit real values.
# See task.md Appendix B and Production_manual.md §1.3.

NODE_ENV="production"
PORT="8080"

# Keep P0 (sandbox) until the M2 gate in task.md §19; P1 = supervised pilot.
CUSTODY_PHASE="P0"

# Database & Redis (Render sets these via fromDatabase/fromService in render.yaml)
# DATABASE_URL="..."
# REDIS_URL="..."

# Security secrets: 32+ random bytes each, different per environment
JWT_SECRET=""
OTP_PEPPER=""
MOMO_WEBHOOK_SECRET=""
# Must equal the Paystack secret key (Paystack signs webhooks with it)
PAYSTACK_WEBHOOK_SECRET=""

# Payment aggregator (Paystack). Test keys on staging.
AGGREGATOR_API_KEY=""
AGGREGATOR_BASE_URL="https://api.paystack.co"

# SMS provider (Arkesel)
ARKESEL_SMS_API_KEY=""

# Object storage (Cloudflare R2)
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="croe-evidence-prod"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"

# Exact admin console origin(s), comma-separated, no trailing slash, no wildcards
CORS_ORIGIN="https://admin.croe.co"

# On-call alert webhook
ALERT_WEBHOOK_URL=""

# Fees (basis points) — set explicitly; see task.md T4.5
COMMISSION_BPS="250"
BUYER_PROTECTION_FEE_BPS="150"

# Retention (days) — confirm with legal (task.md T8.6)
RETENTION_NOTIFICATION_DAYS="30"
RETENTION_SESSION_DAYS="7"

# Local LLM: leave unset for P1 so disputes go to UNDER_HUMAN_REVIEW (task.md T14.4)
# LLM_URL=""
# LLM_MODEL=""
