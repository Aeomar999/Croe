{
  "name": "croe-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@11.1.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --forceExit",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react-native": "^1.0.16",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.60.0",
    "axios": "^1.7.0",
    "expo": "~57.0.24",
    "expo-application": "^57.0.3",
    "expo-device": "^57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-network": "^57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/detox": "^17.14.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "detox": "^20.51.4",
    "jest": "~29.7.0",
    "jest-circus": "^30.4.2",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
