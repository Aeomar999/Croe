    "@tanstack/react-query": "^5.60.0",
    "axios": "^1.7.0",
    "expo": "~54.0.0",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-uuid": "^2.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
